# Render overlay para o fork do MiroFish. Um proxy publica frontend e API numa única porta.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /app
COPY frontend/ /app/frontend/
COPY locales/ /app/locales/
RUN npm ci --prefix frontend --no-audit --no-fund
ENV VITE_API_BASE_URL=/
RUN npm run build --prefix frontend

FROM python:3.11-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends nginx apache2-utils gettext-base ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /usr/local/bin/uv
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock /app/backend/
RUN cd /app/backend && uv sync --frozen --no-dev --no-install-project
RUN uv pip install --python /app/backend/.venv/bin/python gunicorn==23.0.0
COPY backend/ /app/backend/
# O backend carrega idiomas de /app/locales durante o import da aplicação.
COPY locales/ /app/locales/
COPY --from=frontend-build /app/frontend/dist /usr/share/nginx/html
COPY deploy/render/nginx.conf.template /etc/nginx/templates/mirofish.conf.template
COPY deploy/render/start.sh /usr/local/bin/start-mirofish
RUN chmod 755 /usr/local/bin/start-mirofish
ENV PYTHONUNBUFFERED=1 FLASK_HOST=127.0.0.1 FLASK_PORT=5001 FLASK_DEBUG=False OASIS_DEFAULT_MAX_ROUNDS=3
EXPOSE 10000
CMD ["/usr/local/bin/start-mirofish"]
